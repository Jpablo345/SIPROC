# Configuración de SIPROC para el equipo de la administradora.
# armar-paquete.ps1 completa APP_KEY y DB_PASSWORD con valores aleatorios.
# No compartas este archivo: tiene las claves de la aplicación.

APP_NAME=SIPROC
APP_KEY=__APP_KEY__
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_LEVEL=warning

# Base de datos (vive dentro de Docker)
DB_DATABASE=siproc
DB_USERNAME=siproc
DB_PASSWORD=__DB_PASSWORD__

SESSION_LIFETIME=120
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
REDIS_CLIENT=phpredis
REDIS_PASSWORD=null

# Correo: necesario para que los usuarios reciban el código al registrarse.
# Con Gmail, crea una "contraseña de aplicación" en la cuenta y úsala en MAIL_PASSWORD.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SIPROC - UFPSO"

# Inicio de sesión con Google (opcional). La dirección de retorno debe estar
# registrada en la consola de Google: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Apariencia (config/siproc.php). Menú lateral: "rojo" (por defecto, rojo institucional) o "claro".
SIPROC_MENU=rojo
# Foto del panel izquierdo del login, dentro de public/. Si no existe, el panel queda solo con texto.
SIPROC_FOTO_LOGIN=img/login-campus.jpg
